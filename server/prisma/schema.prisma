generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  STUDENT
  MENTOR
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         UserRole @default(STUDENT)

  submission          Submission?  @relation("StudentSubmission")
  reviewedSubmissions Submission[] @relation("SubmissionReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Submission {
  id String @id @default(uuid())

  projectName String
  repoUrl     String
  liveUrl     String
  description String

  status   SubmissionStatus @default(PENDING)
  feedback String?

  studentId    String  @unique
  reviewedById String?

  student    User  @relation("StudentSubmission", fields: [studentId], references: [id])
  reviewedBy User? @relation("SubmissionReviewer", fields: [reviewedById], references: [id])

  reviewedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}
